# Optional private access gate. Empty means the deployment stays open.
# Keep the real value in the untracked server .env only.
SPLITTER_APP_ACCESS_PIN=

# Optional private Netscape cookie file on the server (outside data/jobs).
# Docker example: /app/data/private/youtube.cookies.txt in the persistent volume.
SPLITTER_YOUTUBE_COOKIES_FILE=
# YouTube imports are capped at 1080p, 1 GiB, 1 hour, and 15 minutes of download time.
SPLITTER_YOUTUBE_MAX_BYTES=1073741824
SPLITTER_YOUTUBE_MAX_DURATION_SECONDS=3600
SPLITTER_YOUTUBE_TIMEOUT_SECONDS=900
